		<meta name="generator" content={Astro.generator} />
		<link
			href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<title>Team</title>
	</head>
	<body>
		<TopBar />

		<Team />

		<Footer />
