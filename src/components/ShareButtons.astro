---
interface Props {
  variant?: "light" | "dark" | "header";
}
const { variant = "dark" } = Astro.props;

const shareUrl = Astro.site
  ? new URL(Astro.url.pathname.replace(/index\.html$/, ""), Astro.site).href
  : "https://ai-for-ocean.github.io/workshop2026/";
const shareTitle = "AI4Ocean Workshop 2026";
const shareText =
  "AI4Ocean Workshop 2026 — a two-week workshop on AI for oceans at the University of Washington.";
const encodedUrl = encodeURIComponent(shareUrl);
const encodedText = encodeURIComponent(shareText);
---

<div
  class:list={["share", `share-${variant}`]}
  data-url={shareUrl}
  data-title={shareTitle}
  data-text={shareText}
>
  <button type="button" class="share-toggle" aria-haspopup="true" aria-expanded="false">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    Share
  </button>
  <div class="share-menu" hidden>
    <a
      href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedText}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      X
    </a>
    <a
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      LinkedIn
    </a>
    <a
      href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Facebook
    </a>
    <a
      href={`mailto:?subject=${encodeURIComponent(shareTitle)}&body=${encodeURIComponent(`${shareText}\n\n${shareUrl}`)}`}
    >
      Email
    </a>
    <button type="button" class="copy-link">Copy link</button>
  </div>
</div>

<script>
  document.querySelectorAll(".share").forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>(".share-toggle");
    const menu = root.querySelector<HTMLElement>(".share-menu");
    const copyBtn = root.querySelector<HTMLButtonElement>(".copy-link");
    if (!toggle || !menu) return;

    const close = () => {
      menu.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    };

    toggle.addEventListener("click", async (event) => {
      event.stopPropagation();
      const url = (root as HTMLElement).dataset.url || window.location.href;
      const title = (root as HTMLElement).dataset.title || document.title;
      const text = (root as HTMLElement).dataset.text || title;
      if (navigator.share && !window.matchMedia("(pointer: fine)").matches) {
        try {
          await navigator.share({ title, text, url });
          return;
        } catch (err) {
          if ((err as Error).name === "AbortError") return;
        }
      }
      const willOpen = menu.hidden;
      document.querySelectorAll(".share-menu").forEach((other) => {
        (other as HTMLElement).hidden = true;
      });
      document.querySelectorAll(".share-toggle").forEach((btn) => {
        btn.setAttribute("aria-expanded", "false");
      });
      menu.hidden = !willOpen;
      toggle.setAttribute("aria-expanded", willOpen ? "true" : "false");
    });

    copyBtn?.addEventListener("click", async () => {
      const url = (root as HTMLElement).dataset.url || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const input = document.createElement("input");
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        input.remove();
      }
      const original = copyBtn.textContent;
      copyBtn.textContent = "Copied!";
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 1600);
    });

    document.addEventListener("click", (event) => {
      if (!root.contains(event.target as Node)) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  });
</script>

<style>
  .share {
    position: relative;
    display: inline-block;
  }

  .share-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 8px;
    font-weight: bold;
    font-size: 1.1rem;
    cursor: pointer;
    font-family: inherit;
  }

  .share-toggle svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .share-light .share-toggle {
    background-color: #0288d1;
    color: white;
    border: none;
    padding: 1rem 1.2rem;
  }

  .share-light .share-toggle:hover {
    background-color: #0277bd;
  }

  .share-dark .share-toggle {
    background: transparent;
    color: #e2e8f0;
    border: 1px solid #94a3b8;
    padding: 0.55rem 0.9rem;
    font-size: 1rem;
  }

  .share-dark .share-toggle:hover,
  .share-dark .share-toggle[aria-expanded="true"] {
    background: #1e293b;
    border-color: #e2e8f0;
  }

  .share-header .share-toggle {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.75);
    padding: 0.4rem 0.75rem;
    font-size: 0.95rem;
  }

  .share-header .share-toggle:hover,
  .share-header .share-toggle[aria-expanded="true"] {
    background: rgba(255, 255, 255, 0.14);
  }

  .share-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    z-index: 1100;
    min-width: 10.5rem;
    flex-direction: column;
    background: #fff;
    color: #0f172a;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.18);
    overflow: hidden;
  }

  .share-menu:not([hidden]) {
    display: flex;
  }

  .share-dark .share-menu {
    left: 50%;
    transform: translateX(-50%);
  }

  .share-header .share-menu {
    left: auto;
    right: 0;
  }

  .share-menu a,
  .share-menu .copy-link {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.7rem 0.9rem;
    background: none;
    border: none;
    color: #0f172a !important;
    font: inherit;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
  }

  .share-menu a:hover,
  .share-menu .copy-link:hover {
    background: #e2e8f0;
  }
</style>
